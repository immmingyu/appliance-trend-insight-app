<?xml version="1.0" encoding="utf-8"?>
<!-- F-09 회원가입: 회원 유형(개인 · 사업자) → ① 이메일 → ② 인증번호 → ③ 비밀번호 · 닉네임 또는 사업자 정보
     (앞 단계를 마치면 다음 칸이 열림) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 회원 유형: 개인(바로 이용) · 사업자(관리자 승인 후 이용) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/signup_type_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/signup_type_personal"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/signup_type_personal"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/signup_type_personal" />

                <Button
                    android:id="@+id/signup_type_business"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/signup_type_business" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- 사업자 선택 시 안내 -->
            <TextView
                android:id="@+id/signup_business_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/notice_bg"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:text="@string/signup_business_notice"
                android:textColor="@color/notice_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- ① 이메일 -->
            <TextView
                style="@style/DetailLabel"
                android:layout_marginTop="20dp"
                android:text="@string/signup_step_email" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/signup_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="emailAddress"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:minHeight="48dp" />

                <Button
                    android:id="@+id/signup_send_code"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/signup_send" />
            </LinearLayout>

            <!-- ② 인증번호 -->
            <LinearLayout
                android:id="@+id/signup_code_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/DetailLabel"
                    android:text="@string/signup_step_code" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/signup_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:autofillHints="smsOTPCode"
                        android:hint="@string/hint_code"
                        android:inputType="number"
                        android:maxLength="6"
                        android:minHeight="48dp" />

                    <TextView
                        android:id="@+id/signup_code_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:textColor="@color/score_red" />

                    <Button
                        android:id="@+id/signup_verify"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/signup_verify" />
                </LinearLayout>
            </LinearLayout>

            <!-- ③ 계정 정보 -->
            <LinearLayout
                android:id="@+id/signup_account_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/DetailLabel"
                    android:text="@string/signup_step_account" />

                <EditText
                    android:id="@+id/signup_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:hint="@string/hint_new_password"
                    android:inputType="textPassword"
                    android:minHeight="48dp" />

                <EditText
                    android:id="@+id/signup_password_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:autofillHints="newPassword"
                    android:hint="@string/hint_password_confirm"
                    android:inputType="textPassword"
                    android:minHeight="48dp" />

                <!-- 개인 회원: 닉네임 -->
                <EditText
                    android:id="@+id/signup_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:autofillHints="username"
                    android:hint="@string/hint_nickname"
                    android:inputType="text"
                    android:maxLength="20"
                    android:minHeight="48dp" />

                <!-- 사업자 회원: 회사명 · 업종(목록 + 기타 직접 입력) · 담당자 연락처(선택) -->
                <LinearLayout
                    android:id="@+id/signup_business_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/signup_company"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:autofillHints="organizationName"
                        android:hint="@string/hint_company"
                        android:inputType="text"
                        android:maxLength="100"
                        android:minHeight="48dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/signup_business_type_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_business_type">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/signup_business_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/business_types" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 업종 "기타"를 고르면 보임 -->
                    <EditText
                        android:id="@+id/signup_business_etc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_business_etc"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLength="50"
                        android:minHeight="48dp"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/signup_contact_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:autofillHints="phone"
                        android:hint="@string/hint_contact_phone"
                        android:inputType="phone"
                        android:maxLength="20"
                        android:minHeight="48dp" />
                </LinearLayout>

                <!-- 약관 동의 (전체 · [필수] 이용약관 · [필수] 개인정보). 소셜 첫 가입 화면과 같이 쓴다 (auth/TermsAgreement) -->
                <include
                    layout="@layout/include_terms_agreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />


                <Button
                    android:id="@+id/signup_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/signup_submit" />
            </LinearLayout>

            <TextView
                android:id="@+id/signup_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/score_red"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/signup_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
