<?xml version="1.0" encoding="utf-8"?>
<!-- F-15 마이페이지: 내 정보(또는 로그인 안내) → 최근 본 제품 → 앱 정보 → 회원 탈퇴(로그인했을 때만) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- 로그인했을 때 -->
                    <LinearLayout
                        android:id="@+id/mypage_logged_in"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mypage_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mypage_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/mypage_join"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp" />

                        <!-- 구독 등급 · 만료일 (승인된 사업자 회원만, B2B 단계 5) -->
                        <TextView
                            android:id="@+id/mypage_tier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/brand_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <!-- 사업자 승인 대기 · 거절 안내 (해당할 때만) -->
                        <TextView
                            android:id="@+id/mypage_b2b_notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@color/notice_bg"
                            android:lineSpacingExtra="2dp"
                            android:padding="10dp"
                            android:textColor="@color/notice_text"
                            android:textIsSelectable="true"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/mypage_alerts"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:text="@string/alert_title" />

                            <Button
                                android:id="@+id/mypage_logout"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/logout" />
                        </LinearLayout>

                        <!-- 비밀번호 변경: 이메일 회원만 보인다 (소셜 회원은 비밀번호가 없음) -->
                        <Button
                            android:id="@+id/mypage_password"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/password_change_title"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- 로그인하지 않았을 때 -->
                    <LinearLayout
                        android:id="@+id/mypage_logged_out"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/login_intro"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/mypage_login"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/mypage_login_button" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- F-08 최근 본 제품 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/DetailSectionTitle"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/recent_title" />

                <Button
                    android:id="@+id/mypage_recent_clear"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_clear" />
            </LinearLayout>

            <TextView
                android:id="@+id/mypage_recent_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/recent_empty"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mypage_recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 앱 정보: 항목은 MyPageActivity.setupInfo()에서 이름 · 동작을 넣는다 -->
            <TextView
                style="@style/DetailSectionTitle"
                android:layout_marginStart="16dp"
                android:text="@string/mypage_info_title" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/mypage_contact"
                        layout="@layout/item_setting_row" />

                    <include
                        android:id="@+id/mypage_privacy"
                        layout="@layout/item_setting_row" />

                    <include
                        android:id="@+id/mypage_terms"
                        layout="@layout/item_setting_row" />

                    <include
                        android:id="@+id/mypage_licenses"
                        layout="@layout/item_setting_row" />

                    <include
                        android:id="@+id/mypage_version"
                        layout="@layout/item_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 회원 탈퇴: 눈에 덜 띄게 맨 아래 작은 글씨로 (로그인했을 때만 보임) -->
            <Button
                android:id="@+id/mypage_withdraw"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/mypage_withdraw"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
