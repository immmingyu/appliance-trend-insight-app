<?xml version="1.0" encoding="utf-8"?>
<!-- F-14 AI 추천: 품목 → 예산 → 사용 환경 → 추가 조건 → 미리보기 → 추천 받기 → 결과 3개 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rec_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ① 품목 (하나만) -->
            <TextView
                style="@style/DetailLabel"
                android:layout_marginTop="0dp"
                android:text="@string/recommend_step_category" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/rec_category_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:singleSelection="true" />

            <!-- ② 예산 -->
            <TextView
                style="@style/DetailLabel"
                android:text="@string/recommend_step_budget" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/rec_budget"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:autofillHints="@null"
                    android:hint="@string/recommend_budget_hint"
                    android:inputType="number"
                    android:maxLength="5"
                    android:minHeight="48dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/recommend_budget_unit" />
            </LinearLayout>

            <!-- ③ 사용 환경 · 선호 (여러 개) -->
            <TextView
                style="@style/DetailLabel"
                android:text="@string/recommend_step_condition" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/rec_condition_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- ④ 추가 조건 (자유 입력) -->
            <TextView
                style="@style/DetailLabel"
                android:text="@string/recommend_step_extra" />

            <EditText
                android:id="@+id/rec_extra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="@null"
                android:hint="@string/recommend_extra_hint"
                android:inputType="text"
                android:maxLength="40"
                android:minHeight="48dp" />

            <!-- 미리보기 · 실행 -->
            <TextView
                android:id="@+id/rec_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/rec_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/recommend_submit" />

            <!-- 결과 -->
            <ProgressBar
                android:id="@+id/rec_progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rec_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rec_result_title"
                style="@style/DetailSectionTitle"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rec_limited"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/recommend_limited"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rec_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
