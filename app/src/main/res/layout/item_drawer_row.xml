<?xml version="1.0" encoding="utf-8"?>
<!--
    ☰ 메뉴 한 줄: 아이콘 20dp · 제목 · (있으면) 설명 · (있으면) 끝 아이콘.
    높이 48dp, 설명 줄이 보이면 56dp (MainActivity.bindRow).
    지금 보고 있는 화면이면 bg_drawer_row_active(옅은 주황 · 모서리 16)로 바꾼다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_4">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        app:tint="@color/ink_2" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Gajeon.Body" />

        <TextView
            android:id="@+id/row_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textAppearance="@style/TextAppearance.Gajeon.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_end"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:visibility="gone"
        app:tint="@color/ink_2" />
</LinearLayout>
