<?xml version="1.0" encoding="utf-8"?>
<!-- F-06 구매 타이밍: 판단 → 30일 그래프 → 숫자 요약 → 품목 평균 비교 → 검색 관심도 → 알림 등록 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/timing_product"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="14sp" />

            <!-- 로딩 · 오류 -->
            <LinearLayout
                android:id="@+id/timing_state_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="48dp">

                <ProgressBar
                    android:id="@+id/timing_progress"
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <TextView
                    android:id="@+id/timing_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/timing_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/retry"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 결과 (불러오기 전에는 숨김) -->
            <LinearLayout
                android:id="@+id/timing_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/timing_basis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- ① 판단 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/timing_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="6dp"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/timing_price"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/timing_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="3dp"
                            android:textSize="15sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ② 30일 가격 그래프 -->
                <TextView
                    style="@style/DetailSectionTitle"
                    android:text="@string/timing_chart_title" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/timing_chart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />

                <TextView
                    android:id="@+id/timing_chart_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp" />

                <!-- ③ 숫자 요약 (3칸 × 2줄) -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:columnCount="3">

                    <LinearLayout style="@style/StatCell">
                        <TextView style="@style/StatLabel" android:text="@string/stat_avg" />
                        <TextView android:id="@+id/stat_avg" style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCell">
                        <TextView style="@style/StatLabel" android:text="@string/stat_min" />
                        <TextView android:id="@+id/stat_min" style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCell">
                        <TextView style="@style/StatLabel" android:text="@string/stat_max" />
                        <TextView android:id="@+id/stat_max" style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCell">
                        <TextView style="@style/StatLabel" android:text="@string/stat_diff" />
                        <TextView android:id="@+id/stat_diff" style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCell">
                        <TextView style="@style/StatLabel" android:text="@string/stat_trend" />
                        <TextView android:id="@+id/stat_trend" style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCell">
                        <TextView style="@style/StatLabel" android:text="@string/stat_launch" />
                        <TextView android:id="@+id/stat_launch" style="@style/StatValue" />
                    </LinearLayout>
                </GridLayout>

                <!-- ④ 같은 품목 평균과 비교 (품목 통계가 있을 때만) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/position_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/position_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/position_signal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/position_reason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ⑤ 검색 관심도 (검색 데이터가 있을 때만) -->
                <TextView
                    android:id="@+id/timing_interest_label"
                    style="@style/DetailSectionTitle"
                    android:text="@string/timing_interest_title"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/timing_interest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- ⑥ 가격 알림 (2차 목표에서 연결) -->
                <Button
                    android:id="@+id/timing_alert_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/timing_alert" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
