<?xml version="1.0" encoding="utf-8"?>
<!-- 회원 탈퇴 확인 창: 지워지는 것 안내 + 비밀번호 확인 (MyPageActivity.showWithdrawDialog) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="@string/withdraw_message"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/withdraw_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:autofillHints="password"
        android:hint="@string/withdraw_password_hint"
        android:inputType="textPassword"
        android:minHeight="48dp" />

    <TextView
        android:id="@+id/withdraw_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/score_red"
        android:textSize="13sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/withdraw_progress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
</LinearLayout>
