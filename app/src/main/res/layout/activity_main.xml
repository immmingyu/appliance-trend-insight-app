<?xml version="1.0" encoding="utf-8"?>
<!--
    홈 화면. 검색이 중심이고, 나머지 기능(AI 추천 · AI 상담 · 가격 알림 · 마이페이지)은 왼쪽 위 ☰ 메뉴에 있다.
    위에서부터: 툴바(☰) → 인사 · 검색창 → 카테고리 → 최근 본 제품(있을 때만) → 트렌드 TOP10
    화면 전체가 한 번에 스크롤되고, 맨 위에서 아래로 당기면 트렌드를 새로고침한다.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/home_swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:contentInsetStartWithNavigation="0dp"
                    app:navigationContentDescription="@string/drawer_open"
                    app:navigationIcon="@drawable/ic_menu">

                    <!-- 앱 이름: 굵은 글씨 (기본 툴바 제목은 MainActivity에서 끈다) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:letterSpacing="-0.02"
                        android:text="@string/app_name"
                        android:textColor="@color/brand_text"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                </com.google.android.material.appbar.MaterialToolbar>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_greeting"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- 검색창: 흰 바탕 · 윤곽선 · 가장 둥근 모서리 (디자인 시스템 radius_lg) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/line_strong"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="4dp">

                        <EditText
                            android:id="@+id/home_search_input"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:autofillHints="@null"
                            android:background="@null"
                            android:hint="@string/home_search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="15sp" />

                        <ImageButton
                            android:id="@+id/home_search_button"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/search"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="@color/brand_text" />

                        <!-- F-16 모델명 스캔 -->
                        <ImageButton
                            android:id="@+id/home_scan_button"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/scan_open"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@color/brand_text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── 확장: 매장 모드 (홈의 대표 행동, 옅은 주황 카드) ── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_store_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/brand_container"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_store_title"
                                android:textColor="@color/on_brand_container"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/home_store_desc"
                                android:textColor="@color/on_brand_container"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/home_store_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_store_button"
                            app:icon="@android:drawable/ic_menu_camera"
                            app:iconSize="18dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── F-03 카테고리: 가로로 스크롤 (제목 없이 검색창 바로 아래) ── -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/home_category_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>

                <!-- ── F-08 최근 본 제품 (기록이 있을 때만 보임) ── -->
                <TextView
                    android:id="@+id/home_recent_title"
                    style="@style/HomeSectionTitle"
                    android:text="@string/recent_title"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_recent_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="16dp"
                    android:visibility="gone" />

                <!-- ── F-02 트렌드 TOP10 ── -->
                <TextView
                    style="@style/HomeSectionTitle"
                    android:text="@string/home_trend_title" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp">

                    <!-- 화면 전체가 스크롤되므로 목록 자체는 스크롤하지 않는다 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/home_trend_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                    <!-- 로딩 · 오류 상태: 위에 안내 문구, 아래에 목록 모양의 빈 카드(스켈레톤) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/home_state_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="32dp"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <Button
                            android:id="@+id/home_retry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:text="@string/retry"
                            android:visibility="gone" />

                        <!-- MainActivity에서 Pulse로 깜빡이게 한다 -->
                        <LinearLayout
                            android:id="@+id/home_skeleton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <include layout="@layout/item_trend_skeleton" />

                            <include layout="@layout/item_trend_skeleton" />

                            <include layout="@layout/item_trend_skeleton" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ☰ 메뉴 (왼쪽에서 열림) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/home_nav"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/menu_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
