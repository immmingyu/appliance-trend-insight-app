<?xml version="1.0" encoding="utf-8"?>
<!-- 가전무쌍 앱 아이콘 전경: 냉장고 + 가격표 (시안 C)
     원본 100x100 그림을 0.72배로 줄여 108dp 가운데 안전 영역(66dp) 안에 넣었다 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateX="18"
        android:translateY="18">
        <!-- 냉장고 몸체 -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5"
            android:fillColor="#00000000"
            android:pathData="M36,20 H58 A6,6 0 0 1 64,26 V74 A6,6 0 0 1 58,80 H36 A6,6 0 0 1 30,74 V26 A6,6 0 0 1 36,20 Z" />
        <!-- 냉동실 · 냉장실 구분선 -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5"
            android:pathData="M30,42 H64" />
        <!-- 손잡이 -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M38,28 V35 M38,50 V60" />
        <!-- 가격표 -->
        <group
            android:rotation="-20"
            android:pivotX="66"
            android:pivotY="64">
            <path
                android:fillColor="#FBBF24"
                android:pathData="M56,56 h18 a4,4 0 0 1 4,4 v12 a4,4 0 0 1 -4,4 h-18 l-8,-10 z" />
            <path
                android:fillColor="#6366F1"
                android:pathData="M53.5,66 a2.5,2.5 0 1 0 5,0 a2.5,2.5 0 1 0 -5,0" />
        </group>
    </group>
</vector>
