<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 이상 백업 · 기기 이전 규칙 (backup_rules.xml과 같은 내용).
    로그인 토큰은 클라우드 백업에도, 새 기기로 옮기기에도 넣지 않는다 → 새 기기에서는 다시 로그인.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
