<?xml version="1.0" encoding="utf-8"?>
<!-- 디자인 시스템 글자 · 부품 스타일. 화면에서는 style="@style/..." 또는 textAppearance로 쓴다 -->
<resources>
    <!-- ── 글자 7단계 ── -->
    <style name="TextAppearance.Gajeon.ScoreDisplay" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Gajeon.PriceDisplay" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Gajeon.TitleScreen" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Gajeon.TitleSection" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Gajeon.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.Gajeon.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Gajeon.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>

    <!-- ── 카드: 카드 바탕 · 얇은 테두리 · 모서리 16 · 그림자 없음 ── -->
    <style name="Widget.Gajeon.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
    </style>
    <!-- 매장 모드 판단 카드처럼 한 단계 눈에 띄는 카드 -->
    <style name="Widget.Gajeon.Card.Hero">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
    </style>

    <!-- ── 버튼: 주(주황 채움) · 보조(윤곽) · 글자 ── -->
    <style name="Widget.Gajeon.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Gajeon.Label</item>
    </style>
    <style name="Widget.Gajeon.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Gajeon.Label</item>
        <item name="android:textColor">@color/ink</item>
        <item name="strokeColor">@color/line_strong</item>
    </style>
    <style name="Widget.Gajeon.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Gajeon.Label</item>
    </style>

    <!-- ── 칩: 모서리 8 · 윤곽, 선택되면 옅은 주황 (테마의 secondaryContainer) ── -->
    <style name="Widget.Gajeon.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Gajeon.Small</item>
        <item name="chipStrokeColor">@color/line_strong</item>
    </style>
    <!-- 눌러서 고르는 칩 (정렬 · AI 추천 조건 · 매장 모드 후보) -->
    <style name="Widget.Gajeon.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Gajeon.Small</item>
        <item name="chipStrokeColor">@color/line_strong</item>
    </style>
    <style name="ShapeAppearance.Gajeon.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <!-- ── 툴바: 바탕과 같은 색, 제목은 화면 제목 글자 ── -->
    <style name="Widget.Gajeon.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Gajeon.TitleScreen</item>
        <item name="android:background">@color/page</item>
    </style>

    <!-- ── 판단 배지: 판단색 채움 + 흰 글자, 모서리 8 (배경색은 코드에서 판단에 맞게) ── -->
    <style name="Gajeon.VerdictBadge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/on_score</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ── 주의 안내 상자 ── -->
    <style name="Gajeon.WarnBox" parent="">
        <item name="android:background">@drawable/bg_warn</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/on_warn_container</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>