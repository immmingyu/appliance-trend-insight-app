<?xml version="1.0" encoding="utf-8"?>
<!--
    앱 기본 테마. 디자인 시스템 색을 Material3 색 역할에 연결한다.
    여기만 바꿔도 버튼 · 칩 · 카드 · 입력칸 · 진행 표시 등 Material 부품 색이 앱 전체에서 함께 바뀐다.
-->
<resources>
    <style name="Theme.GajeonTiming" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 대표 주황: 주 버튼 · 선택 · 진행 표시 -->
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <!-- 선택된 칩 · 탭 배경 (Material3는 secondaryContainer를 쓴다) -->
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_container</item>
        <item name="colorTertiary">@color/verdict_good</item>
        <item name="colorError">@color/verdict_wait</item>

        <!-- 바탕 · 카드 · 글자 · 선 -->
        <item name="android:colorBackground">@color/page</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorSurfaceVariant">@color/sunken</item>
        <item name="colorSurfaceContainerLowest">@color/card</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/sunken</item>
        <item name="colorSurfaceContainerHighest">@color/sunken</item>
        <item name="colorOutline">@color/line_strong</item>
        <item name="colorOutlineVariant">@color/line</item>

        <!-- 부품 기본 모양: 디자인 시스템 규칙 -->
        <item name="materialCardViewStyle">@style/Widget.Gajeon.Card</item>
        <item name="materialButtonStyle">@style/Widget.Gajeon.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Gajeon.Button.Outlined</item>
        <item name="chipStyle">@style/Widget.Gajeon.Chip</item>
        <item name="toolbarStyle">@style/Widget.Gajeon.Toolbar</item>
        <item name="android:windowBackground">@color/page</item>
    </style>
</resources>
