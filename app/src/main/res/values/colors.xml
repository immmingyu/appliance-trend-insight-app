<?xml version="1.0" encoding="utf-8"?>
<!--
    밝은 화면(기본)용 색. 다크 모드 값은 values-night/colors.xml에 같은 이름으로 있다.
    색을 새로 쓸 때는 레이아웃에 #코드를 직접 쓰지 말고 여기에 이름을 붙여서 쓸 것.
-->
<resources>
    <!-- 브랜드 보라를 "글씨 · 아이콘"에 쓸 때 (배경 채우기는 splash_logo) -->
    <color name="brand_text">#6750A4</color>
    <!-- 점수 색(score_*) 배지 위의 글씨 -->
    <color name="on_score">#FFFFFF</color>
    <!-- AI 상담 말풍선 -->
    <color name="chat_ai_bubble">#F1F3F4</color>
    <!-- "넓혀서 찾았어요" · AI 주의 같은 안내 상자 -->
    <color name="notice_bg">#FFF4E5</color>
    <color name="notice_text">#8A4B00</color>
    <!-- 앱 소개 화면의 현재 페이지가 아닌 점 -->
    <color name="dot_inactive">#D0C4F0</color>
    <!-- 카카오 로그인 버튼 (카카오 디자인 가이드: 배경 #FEE500 · 글자 검정 85%, 다크 모드에서도 같은 색) -->
    <color name="kakao_container">#FEE500</color>
    <color name="kakao_label">#D9000000</color>
    <!-- Google 로그인 버튼 (Google 브랜드 가이드: 밝은 화면은 흰 배경 · 테두리 #747775) -->
    <color name="google_container">#FFFFFF</color>
    <color name="google_label">#1F1F1F</color>
    <color name="google_stroke">#747775</color>
</resources>
