<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 서버 API 호출에 필요 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- F-12 가격 알림 (안드로이드 13부터 사용자 허용 필요) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GajeonApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GajeonTiming">

        <!-- 앱을 켜면 처음 뜨는 화면: 서버를 깨운 뒤 홈으로 이동 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.GajeonTiming.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" />

        <!-- 앱 소개 (처음 실행할 때만 시작 화면 다음에 나옴) -->
        <activity android:name=".OnboardingActivity" />

        <!-- F-04 제품 목록 (상위 화면: 홈) -->
        <activity
            android:name=".ProductListActivity"
            android:parentActivityName=".MainActivity" />

        <!-- F-05 제품 리포트 (제품 목록 또는 홈의 트렌드에서 들어옴) -->
        <activity android:name=".ProductDetailActivity" />

        <!-- F-06 구매 타이밍 (제품 리포트에서 들어옴) -->
        <activity android:name=".TimingActivity" />

        <!-- F-07 제품 비교 (제품 리포트에서 들어옴, 제품 목록을 고르기 모드로 열어 B를 받음) -->
        <activity android:name=".CompareActivity" />

        <!-- F-16 모델명 스캔 (홈 검색창 옆 카메라 버튼, 상위 화면: 홈) -->
        <activity
            android:name=".ScanActivity"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 카메라 앱이 찍은 사진을 앱 캐시 폴더에 저장할 수 있게 해 주는 통로 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- F-17 AI 상담 (홈 메뉴 또는 제품 리포트, 키보드가 올라오면 입력창도 같이 올라오게) -->
        <activity
            android:name=".ChatActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- F-14 AI 추천 (홈 메뉴, 상위 화면: 홈) -->
        <activity
            android:name=".RecommendActivity"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- F-15 마이페이지 (홈 메뉴, 상위 화면: 홈) -->
        <activity
            android:name=".MyPageActivity"
            android:parentActivityName=".MainActivity" />

        <!-- F-10 로그인 · F-09 회원가입 (마이페이지, 또는 로그인이 필요한 기능에서 들어옴) -->
        <activity android:name=".LoginActivity" />
        <!-- 소셜(카카오) 첫 가입: 닉네임 · 약관 동의 후 가입 -->
        <activity android:name=".SocialSignupActivity" />
        <!-- 비밀번호 변경 (마이페이지, 이메일 회원만) -->
        <activity android:name=".ChangePasswordActivity" />
        <!-- FCM 푸시 받기 (사업자 승인 · 거절 즉시 알림) -->
        <service
            android:name=".alert.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- 앱이 백그라운드일 때 안드로이드가 직접 띄우는 푸시 알림의 채널 · 아이콘 (AlertNotifier의 "회원 안내") -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="account" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- B2B 가격 모니터 (단계 3, 승인된 사업자 회원) -->
        <activity android:name=".b2b.PriceMonitorActivity" />
        <!-- B2B 제품 시장 분석 (단계 4): 검색 → 분석 -->
        <activity
            android:name=".b2b.MarketSearchActivity"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity android:name=".b2b.MarketAnalysisActivity" />

        <!-- 사업자 회원 승인 대기 안내 (B2B 단계 1) -->
        <activity android:name=".PendingApprovalActivity" />

        <!-- 카카오 로그인: 카카오톡 · 카카오계정 로그인 후 이 주소(kakao{앱 키}://oauth)로 앱에 돌아온다 -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="${kakaoScheme}" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SignUpActivity"
            android:parentActivityName=".LoginActivity" />

        <!-- F-11 가격 알림 목록 (홈 메뉴 또는 휴대폰 알림을 눌러 들어옴) -->
        <activity android:name=".AlertListActivity" />

    </application>
</manifest>
